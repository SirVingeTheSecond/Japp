### ============================================
### AUTHENTICATION VALIDATION TESTS
### ============================================

### Login - Wrong Password (should fail with 401)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "emailOrUsername": "marius@japp.com",
  "password": "Skibidi123"
}

###

### Signup - Duplicate Email (should fail with 409)
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "marius@japp.com",
  "username": "anothermarius",
  "firstname": "Another",
  "lastname": "Marius",
  "password": "Skibidi123"
}

###

### Signup - Duplicate Username (should fail with 400)
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "different@japp.com",
  "username": "mariusbh",
  "firstname": "Different",
  "lastname": "User",
  "password": "Skibidi123"
}

###

### Signup - Banned Username "rolf" (should fail with 400)
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "test@japp.com",
  "username": "rolf",
  "firstname": "Test",
  "lastname": "User",
  "password": "Skibidi123"
}

###

### Signup - Invalid Email Format (should fail with 400)
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "invalid-email",
  "username": "testuser",
  "firstname": "Test",
  "lastname": "User",
  "password": "Skibidi123"
}

###

### Signup - Password Too Short (should fail with 400)
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "test@japp.com",
  "username": "testuser",
  "firstname": "Test",
  "lastname": "User",
  "password": "deez"
}

###

### Signup - Password No Digit (should fail with 400)
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "test@japp.com",
  "username": "testuser",
  "firstname": "Test",
  "lastname": "User",
  "password": "Skibidi"
}

###

### Signup - Username Too Short (should fail with 400)
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "test@japp.com",
  "username": "ab",
  "firstname": "Test",
  "lastname": "User",
  "password": "Skibidi123"
}


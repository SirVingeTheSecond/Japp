### ============================================
### AUTHENTICATION TESTS
### ============================================

### Signup User 1 (Marius)
# @name signupMarius
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "marius@japp.com",
  "username": "mariusbh",
  "firstname": "Marius",
  "lastname": "Brandorff-Hansen",
  "password": "Skibidi123",
  "phone": "+45 12345678"
}

> {%
    client.global.set("marius_token", response.body.token);
    client.global.set("marius_id", response.body.user.id);
    client.log("Marius token: " + response.body.token);
    client.log("Marius ID: " + response.body.user.id);
%}

###

### Signup User 2 (Rolf Vandsted)
# Note: Username is "rolfv" not "rolf" because "rolf" is banned in validation
# @name signupRolf
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "rolf@japp.com",
  "username": "rolfv",
  "firstname": "Rolf",
  "lastname": "Vandsted",
  "password": "Toilet123",
  "phone": "+45 87654321"
}

> {%
    client.global.set("rolf_token", response.body.token);
    client.global.set("rolf_id", response.body.user.id);
    client.log("Rolf token: " + response.body.token);
    client.log("Rolf ID: " + response.body.user.id);
%}

###

### Login User 1 (Marius) - by email
# @name loginMariusEmail
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "emailOrUsername": "marius@japp.com",
  "password": "Skibidi123"
}

> {%
    client.global.set("marius_token", response.body.token);
    client.log("Marius login token: " + response.body.token);
%}

###

### Login User 1 (Marius) - by username
# @name loginMariusUsername
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "emailOrUsername": "mariusbh",
  "password": "Skibidi123"
}

###

### Login User 2 (Rolf) - by email
# @name loginRolfEmail
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "emailOrUsername": "rolf@japp.com",
  "password": "Toilet123"
}

> {%
    client.global.set("rolf_token", response.body.token);
    client.log("Rolf login token: " + response.body.token);
%}


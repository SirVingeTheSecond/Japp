### ============================================
### GROUP MANAGEMENT TESTS
### ============================================

### Create Group (Marius)
# @name createGroup
POST http://localhost:8080/api/groups
Authorization: Bearer {{marius_token}}
Content-Type: application/json

{
  "name": "Weekend Trip to Paris",
  "description": "Planning our expenses for the weekend trip"
}

> {%
    client.global.set("group_id", response.body.id);
    client.global.set("invite_code", response.body.inviteCode);
    client.log("Group ID: " + response.body.id);
    client.log("Invite Code: " + response.body.inviteCode);
%}

###

### Get Marius's Groups
GET http://localhost:8080/api/groups
Authorization: Bearer {{marius_token}}

###

### Get Specific Group Details
GET http://localhost:8080/api/groups/{{group_id}}
Authorization: Bearer {{marius_token}}

###

### Get Group Members (should show only Marius initially)
GET http://localhost:8080/api/groups/{{group_id}}/members
Authorization: Bearer {{marius_token}}

###

### Join Group (Rolf joins using invite code)
# @name rolfJoinsGroup
POST http://localhost:8080/api/groups/join
Authorization: Bearer {{rolf_token}}
Content-Type: application/json

{
  "inviteCode": "{{invite_code}}"
}

###

### Get Group Members (should show both Marius and Rolf now)
GET http://localhost:8080/api/groups/{{group_id}}/members
Authorization: Bearer {{marius_token}}

###

### Get Rolf's Groups (should include the joined group)
GET http://localhost:8080/api/groups
Authorization: Bearer {{rolf_token}}

###

